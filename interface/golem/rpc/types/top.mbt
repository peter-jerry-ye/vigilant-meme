        Handle(payload111) => {
          @ffi.store8(base1 + 0, 21)
          let ptr112 = @ffi.str2ptr(payload111.0.value)
          @ffi.store32(base1 + 12, payload111.0.value.length())
          @ffi.store32(base1 + 8, ptr112)
          @ffi.store64(base1 + 16, payload111.1.reinterpret_as_int64())
          @ffi.free(ptr112)
