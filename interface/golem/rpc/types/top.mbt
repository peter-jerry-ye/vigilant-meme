        }
      }
    }
    @ffi.store32(base + 4, element.nodes.length())
    @ffi.store32(base + 0, address113)
    @ffi.free(address113)
  }
  let result : Int = wasmImportMethodWasmRpcAsyncInvokeAndAwait(
    handle,
    ptr,
    function_name.length(),
    address115,
    function_params.length(),
