            @ffi.load32(return_area + 8),
            @ffi.load32(return_area + 12),
          )
          RpcError::NotFound(result128)
        }
        3 => {
          let result131 = @ffi.ptr2str(
            @ffi.load32(return_area + 8),
            @ffi.load32(return_area + 12),
          )
          RpcError::RemoteInternalError(result131)
        }
        _ => panic()
      }
      Result::Err(lifted)
    }
    _ => panic()
  }
  @ffi.free(ptr)
  @ffi.free(address115)
  @ffi.free(return_area)
  cleanup_list.each(@ffi.free)
