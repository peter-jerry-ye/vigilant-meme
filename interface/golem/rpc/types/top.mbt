          @ffi.store16(base1 + 8, payload74.reinterpret_as_int())
          ()
        }
        PrimU32(payload77) => {
          @ffi.store8(base1 + 0, 10)
          @ffi.store32(base1 + 8, payload77.reinterpret_as_int())
          ()
        }
        PrimU64(payload80) => {
          @ffi.store8(base1 + 0, 11)
          @ffi.store64(base1 + 8, payload80.reinterpret_as_int64())
          ()
        }
        PrimS8(payload83) => {
