///|
/// Schedule invocation for later. Call cancel on the returned resource to cancel the invocation before the scheduled time.
pub fn WasmRpc::schedule_cancelable_invocation(
  self : WasmRpc,
  scheduled_time : @wallClock.Datetime,
  function_name : String,
  function_params : Array[WitValue],
) -> CancellationToken {
  let cleanup_list : Array[Int] = []
  let WasmRpc(handle) = self
  let ptr = @ffi.str2ptr(function_name)
  let address115 = @ffi.malloc(function_params.length() * 8)
  for index116 = 0; index116 < function_params.length(); index116 = index116 + 1 {
    let element : WitValue = function_params[index116]
    let base = address115 + index116 * 8
    let address113 = @ffi.malloc(element.nodes.length() * 24)
    for index114 = 0; index114 < element.nodes.length(); index114 = index114 + 1 {
      let element0 : WitNode = element.nodes[index114]
      let base1 = address113 + index114 * 24
      match element0 {
        RecordValue(payload) => {
          @ffi.store8(base1 + 0, 0)
          let address = @ffi.malloc(payload.length() * 4)
          for index = 0; index < payload.length(); index = index + 1 {
            let element4 : Int = payload[index]
