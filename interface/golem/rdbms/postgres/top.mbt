  let return_area = @ffi.malloc(16)
  wasmImportMethodDbTransactionQueryStream(
    handle,
    ptr,
    statement.length(),
    address302,
    params.length(),
    return_area,
  )
  let lifted322 = match @ffi.load8_u(return_area + 0) {
    0 =>
      Result::Ok(DbResultStream::DbResultStream(@ffi.load32(return_area + 4)))
    1 => {
      let lifted = match @ffi.load8_u(return_area + 4) {
        0 => {
          let result = @ffi.ptr2str(
            @ffi.load32(return_area + 8),
            @ffi.load32(return_area + 12),
          )
          Error_::ConnectionFailure(result)
        }
        1 => {
          let result312 = @ffi.ptr2str(
            @ffi.load32(return_area + 8),
            @ffi.load32(return_area + 12),
          )
          Error_::QueryParameterFailure(result312)
        }
        2 => {
          let result315 = @ffi.ptr2str(
            @ffi.load32(return_area + 8),
            @ffi.load32(return_area + 12),
          )
          Error_::QueryExecutionFailure(result315)
        }
        3 => {
          let result318 = @ffi.ptr2str(
            @ffi.load32(return_area + 8),
            @ffi.load32(return_area + 12),
          )
          Error_::QueryResponseFailure(result318)
        }
        4 => {
          let result321 = @ffi.ptr2str(
            @ffi.load32(return_area + 8),
            @ffi.load32(return_area + 12),
          )
          Error_::Other(result321)
        }
        _ => panic()
      }
      Result::Err(lifted)
    }
    _ => panic()
  }
  @ffi.free(ptr)
  @ffi.free(address302)
  @ffi.free(return_area)
  cleanup_list.each(@ffi.free)
  return lifted322
}

///|
pub fn DbTransaction::execute(
  self : DbTransaction,
  statement : String,
  params : Array[DbValue],
) -> Result[UInt64, Error_] {
  let cleanup_list : Array[Int] = []
  let DbTransaction(handle) = self
  let ptr = @ffi.str2ptr(statement)
  let address302 = @ffi.malloc(params.length() * 56)
  for index303 = 0; index303 < params.length(); index303 = index303 + 1 {
    let element : DbValue = params[index303]
    let base = address302 + index303 * 56
    match element {
      Character(payload) => {
        @ffi.store8(base + 0, 0)
        @ffi.store8(base + 8, @ffi.extend8(payload))
