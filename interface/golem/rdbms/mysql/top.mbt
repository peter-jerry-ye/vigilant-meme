///|
pub fn DbTransaction::query_stream(
  self : DbTransaction,
  statement : String,
  params : Array[DbValue],
) -> Result[DbResultStream, Error_] {
  let cleanup_list : Array[Int] = []
  let DbTransaction(handle) = self
  let ptr = @ffi.str2ptr(statement)
  let address125 = @ffi.malloc(params.length() * 24)
  for index126 = 0; index126 < params.length(); index126 = index126 + 1 {
    let element : DbValue = params[index126]
    let base = address125 + index126 * 24
    match element {
      Boolean(payload) => {
        @ffi.store8(base + 0, 0)
        @ffi.store8(base + 8, if payload { 1 } else { 0 })
        ()
      }
      Tinyint(payload4) => {
        @ffi.store8(base + 0, 1)
        @ffi.store8(base + 8, @ffi.extend8(payload4))
