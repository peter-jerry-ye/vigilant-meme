        ()
      }
      Blob(payload95) => {
        @ffi.store8(base + 0, 28)
        let ptr96 = @ffi.bytes2ptr(payload95)
        @ffi.store32(base + 12, payload95.length())
        @ffi.store32(base + 8, ptr96)
        @ffi.free(ptr96)
        ()
      }
      Mediumblob(payload99) => {
