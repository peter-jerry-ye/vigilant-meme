        @ffi.store32(base + 12, payload103.length())
        @ffi.store32(base + 8, ptr104)
        @ffi.free(ptr104)
        ()
      }
      Enumeration(payload107) => {
        @ffi.store8(base + 0, 31)
        let ptr108 = @ffi.str2ptr(payload107)
        @ffi.store32(base + 12, payload107.length())
        @ffi.store32(base + 8, ptr108)
        @ffi.free(ptr108)
        ()
      }
      Set(payload111) => {
        @ffi.store8(base + 0, 32)
        let ptr112 = @ffi.str2ptr(payload111)
        @ffi.store32(base + 12, payload111.length())
        @ffi.store32(base + 8, ptr112)
        @ffi.free(ptr112)
        ()
      }
      Bit(payload115) => {
        @ffi.store8(base + 0, 33)
        let address = @ffi.malloc(payload115.length() * 1)
        for index = 0; index < payload115.length(); index = index + 1 {
          let element116 : Bool = payload115[index]
          let base117 = address + index * 1
          @ffi.store8(base117 + 0, if element116 { 1 } else { 0 })
