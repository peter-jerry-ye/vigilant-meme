        @ffi.store32(base + 12, payload40.length())
        @ffi.store32(base + 8, ptr41)
        @ffi.free(ptr41)
        ()
      }
      Date(payload44) => {
        @ffi.store8(base + 0, 14)
        @ffi.store32(base + 8, payload44.year)
        @ffi.store8(base + 12, payload44.month.to_int())
        @ffi.store8(base + 13, payload44.day.to_int())
        ()
      }
      Datetime(payload47) => {
        @ffi.store8(base + 0, 15)
        @ffi.store32(base + 8, payload47.date.year)
        @ffi.store8(base + 12, payload47.date.month.to_int())
        @ffi.store8(base + 13, payload47.date.day.to_int())
        @ffi.store8(base + 16, payload47.time.hour.to_int())
        @ffi.store8(base + 17, payload47.time.minute.to_int())
        @ffi.store8(base + 18, payload47.time.second.to_int())
        @ffi.store32(base + 20, payload47.time.nanosecond.reinterpret_as_int())
        ()
      }
      Timestamp(payload50) => {
        @ffi.store8(base + 0, 16)
        @ffi.store32(base + 8, payload50.date.year)
        @ffi.store8(base + 12, payload50.date.month.to_int())
        @ffi.store8(base + 13, payload50.date.day.to_int())
        @ffi.store8(base + 16, payload50.time.hour.to_int())
        @ffi.store8(base + 17, payload50.time.minute.to_int())
        @ffi.store8(base + 18, payload50.time.second.to_int())
        @ffi.store32(base + 20, payload50.time.nanosecond.reinterpret_as_int())
        ()
      }
      Time(payload53) => {
